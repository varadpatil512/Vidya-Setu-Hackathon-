# Server
PORT=5000

# MongoDB — paste your Atlas connection string here.
# If left empty and MONGO_MEMORY=true, an in-memory MongoDB is used (dev/demo only).
MONGO_URI=
MONGO_MEMORY=true

# Auth
JWT_SECRET=change-me-in-production

# AI (optional — mock fallback used when no key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Course rules
COURSE_VIDEO_COUNT=5
